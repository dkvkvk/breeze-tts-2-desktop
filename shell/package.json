{
  "name": "breeze-tts-2-desktop",
  "productName": "声轨工坊",
  "version": "2.4.0-alpha.2",
  "description": "声轨工坊是基于 Breeze TTS 2 模型的 Windows 本地配音应用",
  "main": "main.js",
  "author": "dkvkvk",
  "license": "Apache-2.0",
  "scripts": {
    "test": "npm run build:mcp && node --test test/*.test.js",
    "build:mcp": "node build-mcp.js",
    "sync-ui": "node sync-ui.js",
    "start": "npm run sync-ui && electron .",
    "selftest": "npm run sync-ui && electron . --selftest",
    "selftest:offline": "npm run sync-ui && electron . --selftest-offline",
    "dist": "npm run build:mcp && npm run sync-ui && electron-builder --win nsis"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "ai.breezeblue.breeze-tts-2",
    "copyright": "程序代码 Apache-2.0；模型权重仅限研究与非商业用途",
    "directories": {
      "output": "../out-electron"
    },
    "files": [
      "main.js",
      "backend.js",
      "server.js",
      "agent-api.js",
      "chapter-jobs.js",
      "sync-ui.js",
      "ui/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "agent",
        "to": "agent",
        "filter": [
          "voicetrack-mcp.cjs",
          "THIRD_PARTY_LICENSES.txt"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "VoiceTrackStudio",
      "artifactName": "VoiceTrackStudio-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "声轨工坊",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "声轨工坊",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "zh_CN"
      ],
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
